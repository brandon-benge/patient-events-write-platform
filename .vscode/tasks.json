{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Infra: Build Docker Images",
      "type": "shell",
      "command": "docker compose -f infra/docker-compose.yml build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Infra: Build API Jar",
      "type": "shell",
      "command": "mvn -q -f services/pom.xml clean package",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Infra: Setup Python .venv",
      "type": "shell",
      "command": "python3 -m venv .venv && source .venv/bin/activate && python3 -m pip install aiohttp redis",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Infra: Start All Services",
      "type": "shell",
      "command": "docker compose -f infra/docker-compose.yml up -d && sleep 20 && source .venv/bin/activate && python3 infra/scripts/validate_e2e.py",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "Infra: Restart All Services",
      "type": "shell",
      "command": "docker compose -f infra/docker-compose.yml down -v && sleep 5 && docker compose -f infra/docker-compose.yml up -d && sleep 20 && source .venv/bin/activate && python3 infra/scripts/validate_e2e.py",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "Infra: Stop All Services",
      "type": "shell",
      "command": "docker compose -f infra/docker-compose.yml down -v",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "Infra: Restart Flink",
      "type": "shell",
      "command": "docker compose -f infra/docker-compose.yml up -d --force-recreate flink-jobmanager flink-taskmanager flink-submit",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "Infra: Restart Flink(DEBUG)",
      "type": "shell",
      "command": "DEBUG=true docker compose -f infra/docker-compose.yml up -d --force-recreate flink-jobmanager flink-taskmanager flink-submit",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "Infra: View Logs (taskmanager)",
      "type": "shell",
      "command": "docker compose -f infra/docker-compose.yml logs flink-taskmanager",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "group": {
        "kind": "test",
        "isDefault": false
