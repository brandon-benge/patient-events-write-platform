    {
      "label": "DB: Count Records of phi_patient_versions vs deid_patient_versions",
      "type": "shell",
      "command": "docker compose -f infra/docker-compose.yml exec postgres psql -U app -d patient_events -c 'SELECT count(*) FROM phi_patient_versions;SELECT count(*) FROM deid_patient_versions;'",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "new"
      },
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "Kafka: List Topics",
      "type": "shell",
      "command": "docker compose -f infra/docker-compose.yml exec kafka /usr/bin/kafka-topics --bootstrap-server kafka:9092 --list -e",
